COMPOSE_PROJECT_NAME=football-data-platform

# Stage 5A: loopback-only development API, no new credentials required.
API_HOST_PORT=18000
WEB_HOST_PORT=15173
# Stage 8B: app-prod only. Generate/inject an independent key at runtime.
APP_HOST_PORT=18090
DJANGO_SECRET_KEY=set_me
AIRFLOW_HOST_PORT=18080

# Stage 7C: opt-in only; scheduled DAGs are separately paused by default.
PLATFORM_ALERTS_ENABLED=false
PLATFORM_ALERT_PROVIDER=log
# Optional explicit exclusions, comma-separated competition_id/season_id pairs.
PLATFORM_DQ_EXCLUDED_CONTEXTS=

POSTGRES_HOST_PORT=15436
POSTGRES_DB=football_metadata
POSTGRES_USER=football_user
POSTGRES_PASSWORD=change_me

CLICKHOUSE_HTTP_HOST_PORT=18124
CLICKHOUSE_NATIVE_HOST_PORT=19001
CLICKHOUSE_DB=football
CLICKHOUSE_USER=football_user
CLICKHOUSE_PASSWORD=change_me

S3_ENDPOINT=https://s3.<pool>.storage.selcloud.ru
S3_REGION=<pool>
S3_BUCKET=football-data-platform
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# Superset Stage 4A: generate independent secrets locally, never commit them.
SUPERSET_HOST_PORT=18088
SUPERSET_SECRET_KEY=set_me
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset_user
SUPERSET_DB_PASSWORD=set_me
SUPERSET_ADMIN_USERNAME=set_me
SUPERSET_ADMIN_PASSWORD=set_me
SUPERSET_ADMIN_EMAIL=set_me
SUPERSET_CLICKHOUSE_USER=superset_reader
SUPERSET_CLICKHOUSE_PASSWORD=set_me
